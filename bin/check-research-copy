#!/usr/bin/env ruby
# Keep public research claims scoped to verified evidence and explicit future goals.
require 'json'
require 'nokogiri'
require 'yaml'

Dir.chdir(File.expand_path('..', __dir__))
errors = []
check = ->(condition, message) { errors << message unless condition }
copy = ->(node) { node&.text.to_s.gsub(/\s+/, ' ').strip }

about = Nokogiri::HTML(File.read('_site/index.html'))
research = Nokogiri::HTML(File.read('_site/research/index.html'))
cv = Nokogiri::HTML(File.read('_site/cv/index.html'))

check.call(copy.call(about.at_css('#about-name')) == 'Geunhyeong Lee', 'About hero must lead with researcher name')
check.call(about.css('.about-bio p').size == 2, 'About hero should stay focused to 2 concise paragraphs')
check.call(!copy.call(about.at_css('.about-bio')).match?(/\b(UNIST|KAERI)\b/), 'Keep past affiliation bio details on CV rather than About hero')
check.call(copy.call(about.at_css('#bisto-description')).include?('BiSTO'), 'About page must explain BiSTO')
check.call(about.css('.highlight-list, .selected-pub-list, .about-record-line').empty?, 'Keep About page concise without Highlights, Selected Publications, or summary pitch lines')
check.call(about.css('.navbar-nav .nav-item').size == 4, 'Navbar should have 4 clean top-level tabs')
check.call(!about.text.match?(/\b51\s?%|5-bar\b/i), 'About page must not publish unpublished BiSTO numbers')

check.call(copy.call(research.at_css('.research-framework-summary')).include?('digital twins'), 'Research page must summarize the closed-loop framework cleanly')
check.call(research.css('.research-direction-item, .research-pillars-compact').empty?, 'Keep Research Vision concise without duplicating the diagram in thrust cards or pillar bullets')
check.call(research.at_css('img[src*="research_vision_loop"]'), 'Research page must display the closed-loop diagram')
check.call(!research.text.match?(/\b51\s?%|5-bar\b/i), 'Research page must not publish unpublished BiSTO numbers')

check.call(cv.at_css('#teaching') && cv.at_css('#teaching').text.include?('MSU Academy for Teaching'), 'CV page must include mentoring, teaching, and pedagogical training')
check.call(!File.exist?('_site/teaching/index.html'), 'Standalone /teaching/ page should be removed in favor of CV Teaching & Mentoring')

[
  ['About', about.text],
  ['Research', research.text],
  ['CV', cv.text],
  ['llms.txt', File.read('_site/llms.txt')]
].each do |label, text|
  check.call(!text.include?("\u2014"), "#{label} must not contain em dashes")
end

video = about.at_css('#bisto-video')
check.call(video && %w[autoplay muted loop playsinline controls].all? { |attr| video.key?(attr) }, 'Preserve startup playback and no-JS controls fallback')

abort errors.join("\n") unless errors.empty?
puts 'Research copy OK: 4-tab nav, streamlined Research page, integrated CV Teaching & Mentoring, zero em dashes, and zero unpublished BiSTO metrics.'
