#!/usr/bin/env ruby
# Keep public research claims scoped to current evidence and explicit future goals.
require 'json'
require 'nokogiri'
require 'yaml'

Dir.chdir(File.expand_path('..', __dir__))
errors = []
check = ->(condition, message) { errors << message unless condition }
copy = ->(node) { node&.text.to_s.gsub(/\s+/, ' ').strip }
about = Nokogiri::HTML(File.read('_site/index.html'))
data = YAML.safe_load(File.read('_pages/about.md').split(/^---\s*$/, 3)[1])
cv = YAML.safe_load(File.read('_data/cv.yml'))

check.call(copy.call(about.at_css('#research-vision-title')) == "#{data['hero_lead']} #{data['hero_focus']}", 'Hero title must match the approved research identity')
check.call(copy.call(about.at_css('.about-vision-intro')) == data['vision_intro'], 'Research vision must render without lost text')
vision = data['vision_intro']
check.call(vision.split.size <= 50 && vision.split.size < cv.dig('research', 'description').split.size, 'Keep the About vision concise; retain the full research statement in the CV')
check.call(['physical constraints', 'reusable design methods', 'manufacturing and experimental validation', 'nuclear energy systems'].all? { |topic| vision.include?(topic) }, 'The concise vision must preserve the research question, reusable methods, validation, and nuclear focus')
check.call(vision.include?('My long-term goal'), 'Keep the long-term research goal distinct from completed results')
check.call(about.css('.about-method-list h3').map(&:text) == data['research_areas'].map { |area| area['title'] }, 'Preserve the three research approach cards')
check.call(copy.call(about.at_css('.about-method-list')).include?('structural analysis'), 'Include the structural analysis foundation')
future = about.at_css('.about-future-direction')
check.call(copy.call(future) == data['future_direction'] && copy.call(future).start_with?('Looking ahead, I aim'), 'Label design-to-operation learning as a future direction')
check.call(copy.call(future).include?('operational measurements') && copy.call(future).include?('digital twins'), 'The future digital twin direction must connect models with operational measurements')
check.call(future&.previous_element&.[]('class') == 'about-method-list', 'Keep the future direction with the research approach, not a new achievement card')
check.call(copy.call(about.at_css('#bisto-description')).include?('Current work focuses on turbulent cooling-channel design.'), 'BiSTO must state its current application scope')
check.call(about.css('.about-research-links a').map { |a| a['href'] } == %w[/publications/ /cv/ /projects/], 'Keep all three profile links')
video = about.at_css('#bisto-video')
check.call(video && %w[autoplay muted loop playsinline controls].all? { |attr| video.key?(attr) }, 'Preserve startup playback and the no-JavaScript control fallback')

bisto = Nokogiri::HTML(File.read('_site/projects/ai_01_bisto/index.html'))
surrogate = Nokogiri::HTML(File.read('_site/projects/ai_02_thermal_surrogate/index.html'))
check.call(copy.call(bisto.at_css('.project-body')).include?('Future directions include'), 'Manufacturing integration and broader applications must remain future BiSTO directions')
check.call(copy.call(surrogate.at_css('.project-body')).include?('this capability is not part of the current results'), 'Do not imply the thermal surrogate is already an operational digital twin')
check.call(copy.call(surrogate.at_css('.project-body')).include?('operational measurements'), 'Keep the project digital twin direction consistent with About')
frib = Nokogiri::HTML(File.read('_site/projects/tf_99_other/index.html'))
check.call(copy.call(frib.at_css('.project-body')).include?('implementation targeted for 2028'), 'Keep rotating beam-dump implementation explicitly prospective')

graph = about.css('script[type="application/ld+json"]').flat_map { |s| JSON.parse(s.text).fetch('@graph', []) }
person = graph.find { |record| record['@type'] == 'Person' }
check.call(person && %w[multiphysics\ modeling thermal-structural\ analysis].all? { |topic| person['knowsAbout'].include?(topic) }, 'Discovery metadata must reflect the visible multiphysics expertise')
check.call(File.read('_site/llms.txt').include?('AI-driven multiphysics design and optimization'), 'Discovery summary must match the revised profile')

abort errors.join("\n") unless errors.empty?
puts 'Research copy OK: current methods, future directions, preview limits, media controls, and discovery metadata are consistent.'
