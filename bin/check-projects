#!/usr/bin/env ruby
# Run after a Jekyll build to check the archive and its generated case studies.
require 'yaml'
require 'nokogiri'
require 'uri'

Dir.chdir(File.expand_path('..', __dir__))
errors = []
check = ->(condition, message) { errors << message unless condition }
records = Dir['_projects/*.md'].map do |path|
  data = YAML.safe_load(File.read(path).split(/^---\s*$/, 3)[1])
  [File.basename(path, '.md'), data]
end
archive = Nokogiri::HTML(File.read('_site/projects/index.html'))
featured = records.select { |_, data| data['featured'] }.sort_by { |_, data| data['featured_order'] }
methods = records.select { |_, data| data['project_section'] == 'methods' }.sort_by { |_, data| data['method_order'] }
expected_links = records.map { |slug, _| "/projects/#{slug}/" }.sort
actual_links = archive.css('.research-card, .project-list-link').map { |link| link['href'] }.sort
check.call(actual_links == expected_links, 'Every project must appear exactly once in the archive')
check.call(archive.css('#selected-projects .research-card').map { |link| link['href'] } == featured.map { |slug, _| "/projects/#{slug}/" }, 'Featured order is incorrect')
check.call(featured.map(&:first) == %w[tf_01_frib_beam_dump tf_04_rotating_beam_dump tf_02_smr_heat_exchanger], 'Keep the static and rotating beam dumps adjacent, followed by heat exchangers')
check.call(methods.empty?, 'Keep unpublished methods off the archive until they have a full case study')
check.call(archive.css('.research-projects > section > .projects-section-header h2').map(&:text) == ['Selected projects', 'Additional projects'], 'Preserve the project hierarchy')
expected_years = {
  'tf_01_frib_beam_dump' => '2023 - 2025',
  'tf_04_rotating_beam_dump' => '2024 - Present'
}
expected_years.each do |slug, year|
  check.call(records.assoc(slug).last['year'] == year, "#{slug}: incorrect research period")
  card = archive.at_css(".research-card[href='/projects/#{slug}/']")
  check.call(card&.at_css('.research-card-meta')&.text&.include?(year), "#{slug}: research period missing from card")
end
check.call(archive.at_css('.project-list-link[href="/projects/em_01_3d_printable_emp/"]'), 'EM pump must remain in additional projects')
check.call(archive.css('.research-projects img').empty?, 'The project archive should stay image-free')
additional = archive.at_css('#additional-projects')
expected_groups = {
  'Thermal-fluid engineering' => %w[tf_99_other tf_03_oled_display],
  'Liquid-metal & electromagnetic systems' => %w[em_01_3d_printable_emp em_02_raon_charge_stripper em_99_other],
  'AI fault detection' => %w[ot_01_komac_linac]
}
check.call(additional.css('.project-group > h3').map(&:text) == expected_groups.keys, 'Additional research group names or order are incorrect')
additional.css('.project-group').each do |group|
  expected = expected_groups.fetch(group.at_css('h3').text, []).map { |slug| "/projects/#{slug}/" }
  check.call(group.css('.project-list-link').map { |link| link['href'] } == expected, 'A project is missing or in the wrong research group')
  years = group.css('.project-list-link').map { |link| records.assoc(link['href'].split('/').last).last['year'] }
  check.call(years.all? { |year| year.is_a?(String) && year.match?(/\A\d{4}(?: - (?:\d{4}|Present))?\z/) }, 'Project periods must be sortable year strings')
  check.call(years == years.map(&:to_s).sort.reverse, 'Additional projects must be newest first within each research group')
end
check.call(additional.css('.project-list > li').size == records.size - featured.size - methods.size, 'The grouped lists must retain every additional project')
additional.css('.project-list-link').each do |link|
  check.call(link.at_css('div').element_children.map(&:name) == %w[h4 p p], 'Additional projects must show title, summary, then metadata')
end
check.call(archive.css('.research-card-type').empty?, 'Selected research must not repeat type labels above its titles')
check.call(archive.css('.research-card .research-evidence').empty?, 'Selected research must not repeat evidence labels above its outcomes')
archive.css('.research-card').each do |card|
  slug = card['href'].split('/').last
  check.call(card.at_css('.research-card-meta').text.strip == records.assoc(slug).last['year'], "#{slug}: selected metadata should show only the research period")
  data = records.assoc(slug).last
  if data['project_section'] == 'methods'
    check.call(card.css('.research-card-support').empty?, "#{slug}: use the shared methods notice without repeating it in each card")
  elsif data['project_kind'] == 'engineering'
    check.call(card.css('.research-card-outcome').empty?, "#{slug}: do not present ongoing responsibilities as measured results")
    check.call(card.at_css('.research-card-support')&.text&.strip == data['scope_note'], "#{slug}: preserve the engineering scope")
  else
    check.call(card.at_css('.research-card-outcome')&.text&.strip == data['outcome'], "#{slug}: preserve the outcome without an extra label")
  end
end

documents = [['_site/projects/index.html', archive]]
records.each do |slug, data|
  required_fields = %w[card_title summary institution year project_group]
  required_fields += if data['project_kind'] == 'engineering'
    %w[detail_intro scope_note detail_summary_label detail_summary]
  elsif data['publication_notice']
    %w[publication_notice]
  else
    %w[contribution outcome evidence]
  end
  required_fields.each do |field|
    check.call(!data[field].to_s.strip.empty?, "#{slug}: missing #{field}")
  end
  path = "_site/projects/#{slug}/index.html"
  check.call(File.file?(path), "Missing case study: #{slug}")
  next unless File.file?(path)
  html = Nokogiri::HTML(File.read(path))
  documents << [path, html]
  if data['publication_notice']
    card = archive.at_css(".research-card[href='/projects/#{slug}/']")
    check.call(card&.ancestors('section')&.first&.[]('id') == 'ongoing-methods', "#{slug}: publication preview must belong to the methods section")
    check.call(card&.at_css('.research-card-action')&.text&.include?('Brief overview'), "#{slug}: preview should not promise a full case study")
    check.call(html.at_css('.project-publication-notice')&.text == data['publication_notice'], "#{slug}: detail publication notice missing")
    check.call(html.css('.project-brief').empty?, "#{slug}: preview must not expose performance summaries")
    overview = html.at_css('.project-preview .project-body')
    check.call(overview&.element_children&.map(&:name) == %w[h2 p], "#{slug}: preview should contain only a heading and a brief paragraph")
    check.call(overview&.at_css('h2')&.text == 'Brief overview', "#{slug}: brief overview heading missing")
    check.call((25..65).cover?(overview&.at_css('p')&.text.to_s.split.size), "#{slug}: overview must stay concise")
    check.call(!overview&.text.to_s.match?(/\d|%|dataset|architecture|hyperparameter|speedup/i), "#{slug}: keep unpublished technical specifics out of the overview")
    check.call(overview&.next_element&.[]('class') == 'project-publication-notice', "#{slug}: publication notice should follow the overview")
  elsif data['detail_summary']
    check.call(html.css('.project-brief').empty?, "#{slug}: do not repeat the role in a separate contribution box")
    check.call(html.at_css('.project-detail-header .projects-intro')&.text == data['detail_intro'], "#{slug}: lead with the research role")
    summary = html.at_css('.project-detail-summary')
    check.call(summary&.text.to_s.split.join(' ') == "#{data['detail_summary_label']}: #{data['detail_summary']}", "#{slug}: distinguish demonstrated results from development targets")
  else
    check.call(html.css('.project-brief dd').size == 2, "#{slug}: contribution/outcome summary missing")
  end
  check.call(html.at_css('.project-detail-header h1')&.text == (data['detail_title'] || data['card_title']), "#{slug}: title mismatch")
  check.call(html.css('.project-detail-end a').map { |link| link['href'] } == ['/projects/'], "#{slug}: footer navigation should only return to all projects")
  check.call(html.at_css('.project-detail-header .projects-kicker')&.text&.include?(data['year'].to_s), "#{slug}: detail research period mismatch")
  expected_related = (data['related_projects'] || []).map { |relation| "/projects/#{relation.fetch('slug')}/" }
  check.call(html.css('.project-related-list a').map { |link| link['href'] } == expected_related, "#{slug}: related-project links are missing or incorrect")
  if data['project_section'] == 'methods'
    check.call(html.css('.project-related').empty?, "#{slug}: keep the brief overview free of a related-device section")
  end
  if expected_groups.values.flatten.include?(slug)
    check.call(!data['detail_intro'].to_s.empty? && !data['detail_summary'].to_s.empty?, "#{slug}: additional projects need the shared role and evidence summary")
    check.call(html.css('.project-overview > section > h2').map(&:text) == %w[Purpose Approach], "#{slug}: use the same purpose/approach overview as the selected beam-dump projects")
    check.call(html.at_css('.project-body > :first-child')&.[]('class') == 'project-overview', "#{slug}: show the overview before detailed figures or legacy links")
  end
  html.css('.project-body img').each do |image|
    check.call(!image['alt'].to_s.empty? && image.key?('data-zoomable'), "#{slug}: figure needs alt text and zoom")
    check.call(!image['src'].end_with?('.gif'), "#{slug}: animations need pausable video controls")
  end
  previous_level = 1
  html.css('.project-body h2, .project-body h3, .project-body h4').each do |heading|
    level = heading.name.delete_prefix('h').to_i
    check.call(level <= previous_level + 1, "#{slug}: heading levels must not skip")
    previous_level = level
  end
  html.css('video[data-project-animation]').each do |video|
    check.call(%w[controls muted loop playsinline poster width height aria-label aria-describedby].all? { |attr| video.key?(attr) }, "#{slug}: animation controls or accessible description missing")
    check.call(!video.key?('autoplay'), "#{slug}: use reduced-motion-aware autoplay")
    check.call(html.at_css("##{video['aria-describedby']}"), "#{slug}: animation caption missing")
  end
end

additional_evidence = {
  'tf_99_other' => ['Engineering studies', 4, 2],
  'tf_03_oled_display' => ['Design study', 4, 0],
  'em_01_3d_printable_emp' => ['Simulation result', 3, 0],
  'em_02_raon_charge_stripper' => ['Prototype study', 2, 0],
  'em_99_other' => ['Research scope', 2, 0],
  'ot_01_komac_linac' => ['Study result', 3, 0]
}
additional_evidence.each do |slug, (label, image_count, video_count)|
  html = documents.assoc("_site/projects/#{slug}/index.html").last
  check.call(html.at_css('.project-detail-summary-label')&.text == "#{label}:", "#{slug}: retain the evidence type in the summary")
  check.call(html.css('.project-body img').size == image_count && html.css('.project-body video').size == video_count, "#{slug}: preserve all existing research figures and animations")
end

documents.each do |path, html|
  ids = html.css('[id]').map { |el| el['id'] }
  check.call(ids.uniq.size == ids.size, "#{path}: duplicate IDs")
  check.call(html.css('h1').size == 1, "#{path}: expected one h1")
  check.call(html.css('footer.fixed-bottom').empty?, "#{path}: footer must not cover content")
  html.css('[aria-labelledby]').each do |element|
    check.call(element['aria-labelledby'].split.all? { |id| ids.include?(id) }, "#{path}: broken accessible label")
  end
  html.css('main a[href], [role="main"] a[href], .project-body img[src], .project-body source[src], .project-body video[poster]').each do |el|
    url = el['href'] || el['src'] || el['poster']
    next unless url.start_with?('/')
    target = URI.parse(url).path
    target += 'index.html' if target.end_with?('/')
    check.call(File.file?(File.join('_site', target.delete_prefix('/'))), "#{path}: missing target #{url}")
  end
  check.call(!html.text.match?(/Liquid (?:Exception|Error)|\{\{|\{%/), "#{path}: unrendered Liquid")
end

beam_dump = documents.assoc('_site/projects/tf_01_frib_beam_dump/index.html')&.last
check.call(beam_dump&.at_css('h1')&.text == 'Static beam dump AI optimization', 'Static beam dump title must include AI')
animations = beam_dump.css('video[data-project-animation]')
check.call(animations.size == 2, 'Static beam dump must show both GA and RL animations')
animations.each do |video|
  check.call(%w[controls muted loop playsinline poster width height aria-label aria-describedby].all? { |attr| video.key?(attr) }, 'Project animations need controls, dimensions, a poster, and accessible descriptions')
  check.call(!video.key?('autoplay'), 'Autoplay must respect reduced-motion preferences through the media script')
  check.call(beam_dump.at_css("##{video['aria-describedby']}"), 'Animation caption missing')
end
check.call(animations.map { |video| video.at_css('source')['src'] } == %w[/assets/video/static-beam-dump-ga.mp4 /assets/video/static-beam-dump-rl.mp4], 'GA and RL media are missing or out of order')

frib = documents.assoc('_site/projects/tf_99_other/index.html').last
rotating = documents.assoc('_site/projects/tf_04_rotating_beam_dump/index.html').last
check.call(rotating.at_css('.project-detail-header .projects-intro')&.text&.include?('I lead the FRIB rotating beam-dump effort from manufacturability assessment through fabrication and installation'), 'The rotating project must communicate engineering leadership beyond simulation')
check.call(rotating.at_css('.project-overview-purpose a')&.[]('href') == '/projects/tf_01_frib_beam_dump/', 'Explain the static-to-rotating upgrade path')
device_copy = rotating.at_css('.project-overview-purpose')&.text.to_s
check.call(['above 50 kW', 'around the circumference', 'thin shell', 'energy directly in the cooling water'].all? { |phrase| device_copy.include?(phrase) }, 'Preserve the beam-dump purpose and heat-deposition mechanism')
check.call(rotating.at_css('.project-detail-summary')&.text.to_s.split.join(' ') == 'Development target: 100 kW primary beam power by 2028.', 'Identify the primary beam power and year as a development target, not achieved performance')
engineering_copy = rotating.at_css('.project-overview-approach')&.text.to_s
check.call(%w[integrates thermal-hydraulic radiation sealing manufacturing installation].all? { |topic| engineering_copy.include?(topic) }, 'Describe the integrated engineering requirements without repeating the leadership claim')
check.call(engineering_copy.include?('I perform thermal-fluid, structural, and electromagnetic simulations.'), 'State the simulation disciplines explicitly')
check.call(engineering_copy !~ /I coordinate|I lead|my multiphysics/, 'Keep leadership in the project introduction rather than repeating it in the scope')
simulation_source = '/assets/img/project/tf_other/rotating_beam_dump.png'
views = rotating.css('.project-simulation-gallery svg')
check.call(views.map { |view| view['viewbox'] || view['viewBox'] } == ['2535 0 1009 1195', '1345 0 1190 1195', '0 0 1310 1195'], 'Show all three simulation panels without clipping their units or color scales')
check.call(views.all? { |view| view['role'] == 'img' && view.at_css('title') && view.at_css('image')&.[]('href') == simulation_source }, 'Simulation viewports must reuse the original image and have accessible descriptions')
check.call(rotating.css('.project-simulation-view').size == 3 && rotating.css('.project-simulation-gallery a').empty?, 'Display every simulation inline without navigation to a separate image')
check.call(rotating.css('.project-simulation-gallery figcaption').map(&:text) == ['Temperature distribution.', 'Pressure distribution.', 'Magnetic flux density.'], 'Label each simulation with the quantity it shows')
check.call(!rotating.at_css('.project-simulation-note') && !rotating.text.include?('Select either view'), 'Remove the redundant image-opening instruction')
check.call(rotating.at_css('.project-simulations h2')&.text == 'Simulation views', 'Introduce the simulation gallery without implying completed device performance')
beam_dumps = [beam_dump, rotating]
beam_dumps.each do |page|
  check.call(page.css('.project-overview > section > h2').map(&:text) == %w[Purpose Approach], 'Both beam-dump pages need the same purpose/approach overview')
  check.call(page.at_css('.project-body > :first-child')&.[]('class') == 'project-overview', 'Begin both beam-dump bodies with the shared overview')
end
check.call(beam_dump.at_css('.project-detail-summary-label')&.text == 'Simulation result:', 'Keep the static numerical result distinct from a development target')
check.call(beam_dump.css('.project-related').empty?, 'Keep the static case study free of a related-development section')
check.call(!rotating.to_html.include?('assembly-cad'), 'Do not reuse the misidentified CAD image')
check.call(rotating.css('.project-related').empty?, 'Do not link the rotating case study to unpublished method pages')
check.call(rotating.at_css('.project-body')&.text !~ /%|dataset|hyperparameter|speedup/i, 'Do not add unpublished method performance claims')
check.call(rotating.at_css('.project-body')&.text.to_s.scan(/\d+(?:\.\d+)?/).all? { |number| %w[50 100 2028].include?(number) }, 'Only include the user-approved upgrade target numbers in the project description')
check.call(archive.css('.research-card-wide').empty? && archive.css('.research-selected-grid > .research-card').size == 3, 'Selected projects must use equal cards, without a double-width exception')
check.call(frib.css('.project-body a[href="/projects/tf_04_rotating_beam_dump/"]').empty? && !frib.text.include?('For rotating beam-dump analysis'), 'Do not show the removed rotating beam-dump relocation notice')
check.call(frib.css('img').none? { |image| image['src'].include?('rotating_beam_dump') }, 'Do not duplicate the rotating beam-dump case study in additional engineering')
check.call(frib.css('video[data-project-animation]').size == 2, 'FRIB analyses need both controllable animations')
check.call(frib.css('.project-media-grid .caption').size == 4, 'Each responsive FRIB figure needs its own caption')
check.call(frib.css('.project-media-grid .caption').none? { |caption| caption.text.match?(/\b(left|right)\b/) }, 'Stacked mobile figures must not use left/right captions')
oled = documents.assoc('_site/projects/tf_03_oled_display/index.html').last
check.call(oled.text.include?('C-2022-049451') && !oled.text.include?('C-2022-149451'), 'OLED software registration must match the CV')
komac = documents.assoc('_site/projects/ot_01_komac_linac/index.html').last
check.call(komac.text.include?('5 of 10') && komac.text.include?('retrospective'), 'KOMAC results must retain their evaluation scope')
check.call(!komac.text.include?('Reduced unnecessary shutdowns'), 'Do not imply measured KOMAC downtime reductions')
heat = documents.assoc('_site/projects/tf_02_smr_heat_exchanger/index.html').last
check.call(archive.at_css(".research-card[href='/projects/tf_02_smr_heat_exchanger/'] h3")&.text == 'AI-designed nuclear heat exchangers', 'Keep the heat-exchanger card title concise and explicit about the nuclear application')
check.call(heat.at_css('.project-detail-header h1')&.text == 'AI-designed heat exchangers for small modular reactors', 'Identify the SMR application in the heat-exchanger detail title')
check.call(heat.css('h3').map(&:text).include?('Dual-fluid topology optimization (2023)'), 'Separate the 2023 heat exchanger baseline')
check.call(heat.css('h3').map(&:text).include?('DRL-assisted topology optimization (2024)'), 'Separate the 2024 heat exchanger baseline')

previews = records.select { |_, data| data['publication_notice'] }.map(&:first).sort
check.call(previews.empty?, 'Do not publish placeholder pages for unpublished work')
publications = Nokogiri::HTML(File.read('_site/publications/index.html'))
check.call(publications.at_css('a[href="https://doi.org/10.2139/ssrn.7128856"]'), 'Surrogate preprint must remain available on Publications')
abort errors.join("\n") unless errors.empty?
puts "Projects OK: #{featured.size} selected, #{records.size - featured.size} additional; all case studies, links, assets, and publication boundaries valid."
