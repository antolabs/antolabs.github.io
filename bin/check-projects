#!/usr/bin/env ruby
# Run after a Jekyll build to check the unified Research & Projects page and generated case studies.
require 'yaml'
require 'nokogiri'
require 'uri'

Dir.chdir(File.expand_path('..', __dir__))
errors = []
check = ->(condition, message) { errors << message unless condition }
records = Dir['_projects/*.md'].map do |path|
  data = YAML.safe_load(File.read(path).split(/^---\s*$/, 3)[1])
  [File.basename(path, '.md'), data]
end
archive = Nokogiri::HTML(File.read('_site/research/index.html'))
featured = records.select { |_, data| data['featured'] }.sort_by { |_, data| data['featured_order'] }
expected_links = records.map { |slug, _| "/projects/#{slug}/" }.sort
actual_links = archive.css('.research-card, .project-list-link').map { |link| link['href'] }.sort

check.call(actual_links == expected_links, 'Every project must appear exactly once on /research/')
check.call(archive.css('#projects .research-card').map { |link| link['href'] } == featured.map { |slug, _| "/projects/#{slug}/" }, 'Featured order is incorrect')
check.call(featured.map(&:first) == %w[tf_01_frib_beam_dump tf_04_rotating_beam_dump tf_02_smr_heat_exchanger em_01_3d_printable_emp], 'Selected projects should present the 4 flagship thermal-fluid & MHD projects')
check.call(archive.css('#projects .research-card img').size == 4, 'Each selected project card should show a real engineering figure')

redirect_html = File.read('_site/projects/index.html')
check.call(redirect_html.include?('/research/#projects'), 'Legacy /projects/ URL must redirect to /research/#projects')

additional = archive.at_css('#additional-projects')
expected_additional = %w[tf_99_other ot_01_komac_linac tf_03_oled_display em_02_raon_charge_stripper em_99_other].map { |slug| "/projects/#{slug}/" }
check.call(additional.css('.project-group').empty?, 'Additional projects should render as one clean chronological list without sparse subgroups')
check.call(additional.css('.project-list-link').map { |link| link['href'] } == expected_additional, 'Additional projects list order or entries are incorrect')

documents = [['_site/research/index.html', archive]]
records.each do |slug, data|
  path = "_site/projects/#{slug}/index.html"
  check.call(File.file?(path), "Missing case study: #{slug}")
  next unless File.file?(path)
  html = Nokogiri::HTML(File.read(path))
  documents << [path, html]
  check.call(html.at_css('.project-detail-header h1')&.text == (data['detail_title'] || data['card_title']), "#{slug}: title mismatch")
  check.call(html.css('.project-detail-end a').map { |link| link['href'] } == ['/research/#projects', '/publications/'], "#{slug}: footer navigation should link to Research & Publications")
  html.css('.project-body img').each do |image|
    check.call(!image['alt'].to_s.empty? && image.key?('data-zoomable'), "#{slug}: figure needs alt text and zoom")
    check.call(!image['src'].end_with?('.gif'), "#{slug}: animations need pausable video controls")
  end
  html.css('video[data-project-animation]').each do |video|
    check.call(%w[controls muted loop playsinline poster width height aria-label aria-describedby].all? { |attr| video.key?(attr) }, "#{slug}: animation controls or accessible description missing")
    check.call(!video.key?('autoplay'), "#{slug}: use reduced-motion-aware autoplay")
  end
end

documents.each do |path, html|
  ids = html.css('[id]').map { |el| el['id'] }
  check.call(ids.uniq.size == ids.size, "#{path}: duplicate IDs")
  check.call(html.css('h1').size == 1, "#{path}: expected one h1")
  check.call(html.css('footer.fixed-bottom').empty?, "#{path}: footer must not cover content")
  html.css('main a[href], [role="main"] a[href], .project-body img[src], .project-body source[src], .project-body video[poster], .research-card img[src]').each do |el|
    url = el['href'] || el['src'] || el['poster']
    next unless url.start_with?('/')
    target = URI.parse(url).path
    target += 'index.html' if target.end_with?('/')
    check.call(File.file?(File.join('_site', target.delete_prefix('/'))), "#{path}: missing target #{url}")
  end
  check.call(!html.text.match?(/Liquid (?:Exception|Error)|\{\{|\{%/), "#{path}: unrendered Liquid")
end

rotating = documents.assoc('_site/projects/tf_04_rotating_beam_dump/index.html')&.last
check.call(rotating.at_css('.project-body')&.text !~ /%|dataset|hyperparameter|speedup/i, 'Do not add unpublished method performance claims on rotating beam dump page')
check.call(rotating.at_css('.project-body')&.text.to_s.scan(/\d+(?:\.\d+)?/).all? { |number| %w[50 100 2028].include?(number) }, 'Only include approved upgrade target numbers on rotating beam dump page')

publications = Nokogiri::HTML(File.read('_site/publications/index.html'))
check.call(publications.at_css('a[href="https://doi.org/10.2139/ssrn.7128856"]'), 'Surrogate preprint must remain available on Publications')
abort errors.join("\n") unless errors.empty?
puts "Projects OK: unified on /research/ (#{featured.size} selected 2x2 with visuals, #{records.size - featured.size} additional); /projects/ redirects cleanly."
