---
layout: default
---
{% assign cv = site.data.cv %}
{% assign cv_date_raw = page.cv_pdf | remove: '.pdf' | split: '_' | last %}
{% assign cv_yy = cv_date_raw | slice: 0, 2 %}
{% assign cv_mm = cv_date_raw | slice: 2, 2 %}
{% assign cv_dd = cv_date_raw | slice: 4, 2 %}
{% capture cv_date %}20{{ cv_yy }}-{{ cv_mm }}-{{ cv_dd }}{% endcapture %}
{% assign total_reviews = 0 %}
{% for r in cv.service.reviews %}
  {% assign total_reviews = total_reviews | plus: r.count %}
{% endfor %}

<div class="post cv-page">
  <header class="cv-header">
    <div>
      <p class="cv-kicker">{{ cv.name | escape }}</p>
      <h1 class="post-title">Curriculum Vitae</h1>
      <p class="cv-intro">
        {{ cv.appointments.first.title | escape }} &middot; FRIB, Michigan State University
        {% if cv.email %}
          <span class="cv-intro-sep" aria-hidden="true">&middot;</span>
          <a class="cv-email-link" href="mailto:{{ cv.email | escape }}">{{ cv.email | escape }}</a>
        {% endif %}
      </p>
    </div>
    <div class="cv-header-actions">
      <a class="cv-download-btn" href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url | bust_file_cache }}" download="{{ page.cv_pdf }}">
        <svg class="cv-download-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4"></path>
        </svg>
        Download Full CV <span class="cv-file-type">PDF</span>
      </a>
      <p class="cv-updated">Updated <time datetime="{{ cv_date }}">{{ cv_date | date: '%B %-d, %Y' }}</time></p>
    </div>
  </header>

  <article>
    <section class="cv-section" id="appointments" aria-labelledby="appointments-heading">
      <div class="cv-section-label">
        <h2 id="appointments-heading">Experience</h2>
      </div>
      <div class="cv-section-body">
        {% include cv/entries.liquid entries=cv.appointments %}
      </div>
    </section>

    <section class="cv-section" id="education" aria-labelledby="education-heading">
      <div class="cv-section-label">
        <h2 id="education-heading">Education</h2>
      </div>
      <div class="cv-section-body">
        {% include cv/entries.liquid entries=cv.education %}
      </div>
    </section>

    <section class="cv-section" id="publications" aria-labelledby="publications-heading">
      <div class="cv-section-label">
        <h2 id="publications-heading">Research Output</h2>
      </div>
      <div class="cv-section-body">
        <dl class="cv-output-summary">
          <div class="cv-output-primary">
            <dt>
              <strong>Published SCIE journal articles</strong>
              <span class="cv-output-detail">
                {{ cv.publications.first_author }} first/co-first
                <span aria-hidden="true">&middot;</span>
                {{ cv.publications.corresponding_author }} corresponding
                {% if cv.publications.jcr_q1 %}
                  <span aria-hidden="true">&middot;</span>
                  {{ cv.publications.jcr_q1 }} in JCR Q1 journals
                {% endif %}
              </span>
            </dt>
            <dd>{{ cv.publications.published }}</dd>
          </div>
          <div><dt>Manuscripts under review</dt><dd>{{ cv.publications.manuscripts.size }}</dd></div>
          <div><dt>Conference presentations &amp; proceedings</dt><dd>{{ cv.conferences.completed.size }}</dd></div>
          <div><dt>Invited talks</dt><dd>{{ cv.invited_talks.size }}</dd></div>
          <div><dt>Registered patents</dt><dd>{{ cv.patents.size }}</dd></div>
          <div><dt>Journal peer reviews</dt><dd>{{ total_reviews }}</dd></div>
        </dl>
      </div>
    </section>

    <section class="cv-section" id="teaching" aria-labelledby="teaching-heading">
      <div class="cv-section-label">
        <h2 id="teaching-heading">Mentoring &amp; Teaching</h2>
      </div>
      <div class="cv-section-body">
        <ul class="cv-compact-list">
          <li>
            <span class="cv-compact-year">2026 - Present</span>
            <div class="cv-compact-detail">
              <strong>Research Mentoring</strong> <span class="cv-inline-muted">&middot; FRIB, Michigan State University</span>
              <p class="cv-compact-note">Mentoring 3 MSU students (2 undergraduates, 1 graduate student) on induction heating validation and AI geometry optimization.</p>
            </div>
          </li>
          <li>
            <span class="cv-compact-year">2023</span>
            <div class="cv-compact-detail">
              <strong>Lecturer, Foundation of AI</strong> <span class="cv-inline-muted">&middot; International School on Beam Dynamics and Accelerator Technology</span>
            </div>
          </li>
          <li>
            <span class="cv-compact-year">2016 - 2021</span>
            <div class="cv-compact-detail">
              <strong>Instructor &amp; Teaching Assistant</strong> <span class="cv-inline-muted">&middot; UNIST</span>
              <p class="cv-compact-note">Nuclear Comprehensive Design Project, Fundamental of Electromagnetics, and Liquid Metal Magnetohydrodynamics.</p>
            </div>
          </li>
          <li>
            <span class="cv-compact-year">Training</span>
            <div class="cv-compact-detail">
              <strong>MSU Academy for Teaching</strong> <span class="cv-inline-muted">&middot; Michigan State University</span>
              <p class="cv-compact-note">Course design, student engagement, and generative AI in education.</p>
            </div>
          </li>
        </ul>
        <p class="cv-pdf-note">
          Complete lists of invited talks, patents, awards, conference proceedings, and journal peer reviews are included in the downloadable PDF CV above.
        </p>
      </div>
    </section>
  </article>
</div>
