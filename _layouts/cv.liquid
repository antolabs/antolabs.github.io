---
layout: default
---
{% assign cv = site.data.cv %}
{% assign cv_date_raw = page.cv_pdf | remove: '.pdf' | split: '_' | last %}
{% assign cv_yy = cv_date_raw | slice: 0, 2 %}
{% assign cv_mm = cv_date_raw | slice: 2, 2 %}
{% assign cv_dd = cv_date_raw | slice: 4, 2 %}
{% capture cv_date %}20{{ cv_yy }}-{{ cv_mm }}-{{ cv_dd }}{% endcapture %}
{% assign sections = 'Experience|Education|Research output' | split: '|' %}
{% assign section_ids = 'appointments|education|publications' | split: '|' %}

<div class="post cv-page">
  <header class="cv-header">
    <div>
      <p class="cv-kicker">{{ cv.name | escape }}</p>
      <h1 class="post-title">Curriculum Vitae</h1>
      <p class="cv-intro">{{ cv.appointments.first.title | escape }} &middot; FRIB, Michigan State University</p>
    </div>
    <div class="cv-header-actions">
      <a class="cv-download-btn" href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" download="{{ page.cv_pdf }}">
        <svg class="cv-download-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M12 3v12m-5-5 5 5 5-5M5 17v4h14v-4"></path>
        </svg>
        Download Full CV <span class="cv-file-type">PDF</span>
      </a>
      <p class="cv-updated">Updated <time datetime="{{ cv_date }}">{{ cv_date | date: '%B %-d, %Y' }}</time></p>
    </div>
  </header>

  <article>
    {% for section in sections %}
      {% assign section_id = section_ids[forloop.index0] %}
      <section class="cv-section" id="{{ section_id }}" aria-labelledby="{{ section_id }}-heading">
        <div class="cv-section-label">
          <h2 id="{{ section_id }}-heading">{{ section }}</h2>
        </div>
        <div class="cv-section-body">
          {% case section_id %}
            {% when 'appointments' %}
              {% include cv/entries.liquid entries=cv.appointments %}
            {% when 'education' %}
              {% include cv/entries.liquid entries=cv.education hide_department=true hide_description=true %}
            {% when 'publications' %}
              <div class="cv-publication-summary">
                <h3>{{ cv.publications.published }} published SCIE journal articles</h3>
                <p><strong>{{ cv.publications.first_author }}</strong> first/co-first author <span aria-hidden="true">&middot;</span> <strong>{{ cv.publications.corresponding_author }}</strong> corresponding author</p>
                <a class="cv-text-link" href="{{ '/publications/' | relative_url }}">View publications <span aria-hidden="true">&#8594;</span></a>
              </div>
              <dl class="cv-output-summary">
                <div><dt>Other journal publications</dt><dd>{{ cv.publications.other.size }}</dd></div>
                <div><dt>Conference contributions</dt><dd>{{ cv.conferences.completed.size }} completed <span>+ {{ cv.conferences.upcoming.size }} upcoming</span></dd></div>
                <div><dt>Registered patents</dt><dd>{{ cv.patents.size }}</dd></div>
              </dl>
          {% endcase %}
        </div>
      </section>
    {% endfor %}
  </article>
</div>
