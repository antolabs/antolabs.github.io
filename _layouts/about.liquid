---
layout: default
---
<div class="post about-page">
  <article>
    <section class="about-intro" aria-labelledby="about-name">
      {% if page.profile.image %}
        <div class="about-portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_alt %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
          {% include figure.liquid path=profile_image_path class="about-portrait-image" sizes="(max-width: 767px) 42vw, (max-width: 991px) 260px, 330px" alt=profile_alt loading="eager" cache_bust=true %}
        </div>
      {% endif %}
      <div class="about-intro-copy">
        <header class="about-identity">
          <h1 id="about-name">
            {{ site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name }}
          </h1>
          <p class="about-affiliation">{{ page.subtitle }}</p>
        </header>
        <div class="about-vision">
          <h2 id="research-vision-title">
            <span>{{ page.hero_lead | escape }}</span>
            <span>{{ page.hero_focus | escape | replace: 'thermal-fluid', '<span class="about-keep-word">thermal-fluid</span>' }}</span>
          </h2>
          <p class="about-vision-intro">
            {{
              page.vision_intro
              | escape
              | replace: 'AI-driven', '<span class="about-keep-word">AI-driven</span>'
              | replace: 'thermal-fluid', '<span class="about-keep-word">thermal-fluid</span>'
            }}
          </p>
          <div class="about-research-links">
            <a href="{{ '/publications/' | relative_url }}">View publications <span aria-hidden="true">&#8594;</span></a>
            <a href="{{ '/cv/' | relative_url }}">View CV <span aria-hidden="true">&#8594;</span></a>
            <a href="{{ '/projects/' | relative_url }}">View projects <span aria-hidden="true">&#8594;</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="about-research" aria-labelledby="bisto-title">
      <figure class="bisto-feature">
        <figcaption class="bisto-summary">
          <p class="about-eyebrow">Research in focus</p>
          <h2 id="bisto-title">BiSTO</h2>
          <p class="bisto-fullname">Binary <span class="about-keep-word">Surrogate-based</span> Topology Optimization</p>
        </figcaption>
        <div class="bisto-visual">
          <div class="bisto-media">
            <video
              id="bisto-video"
              width="884"
              height="620"
              muted
              loop
              playsinline
              controls
              preload="auto"
              poster="{{ '/assets/img/bisto-poster.webp' | relative_url }}"
              aria-label="BiSTO topology evolution"
              aria-describedby="bisto-description bisto-regions bisto-sequence-note bisto-temperature-note"
            >
              <source src="{{ '/assets/video/bisto-topology.mp4' | relative_url }}" type="video/mp4">
              <img
                src="{{ '/assets/img/bisto-poster.webp' | relative_url }}"
                width="884"
                height="620"
                alt="Cutaway of a rotating beam dump showing shell temperature, black solid regions, and blue fluid regions."
              >
            </video>
            <div class="bisto-annotations" data-solid-phase="initial" aria-hidden="true">
              <svg class="bisto-leaders" viewBox="0 0 884 620" focusable="false">
                <g class="bisto-solid-initial">
                  <path class="bisto-leader-halo" d="M 112,66 L 150,130 L 260,240" />
                  <path class="bisto-leader-solid" d="M 112,66 L 150,130 L 260,240" />
                  <circle class="bisto-target-solid" cx="260" cy="240" r="6" />
                </g>
                <g class="bisto-solid-evolved">
                  <path class="bisto-leader-halo" d="M 112,66 L 150,130 L 320,285" />
                  <path class="bisto-leader-solid" d="M 112,66 L 150,130 L 320,285" />
                  <circle class="bisto-target-solid" cx="320" cy="285" r="6" />
                </g>
                <g>
                  <path class="bisto-leader-halo" d="M 100,565 L 255,565 L 315,460 L 360,345" />
                  <path class="bisto-leader-fluid" d="M 100,565 L 255,565 L 315,460 L 360,345" />
                  <circle class="bisto-target-fluid" cx="360" cy="345" r="6" />
                </g>
              </svg>
              <span class="bisto-callout bisto-callout-solid"><strong>Solid</strong></span>
              <span class="bisto-callout bisto-callout-fluid"><strong>Fluid</strong></span>
            </div>
            <button
              class="bisto-toggle"
              type="button"
              aria-controls="bisto-video"
              aria-label="Play animation"
              title="Play animation"
              data-playing="false"
              hidden
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path class="bisto-icon-play" d="M 7,4 L 20,12 L 7,20 Z" />
                <g class="bisto-icon-pause"><rect x="5" y="4" width="5" height="16" /><rect x="14" y="4" width="5" height="16" /></g>
              </svg>
            </button>
          </div>
          <p class="sr-only" id="bisto-regions">
            The Solid pointer identifies the outer shell first, then the black solid region as it develops in the cutaway. The Fluid pointer
            identifies the blue fluid region.
          </p>
          <p class="sr-only" id="bisto-sequence-note">The animation shows design iterations, not elapsed physical time.</p>
          <p class="bisto-temperature-note" id="bisto-temperature-note">
            Solid-fluid design to minimize temperature &mdash; rotating beam dump example.
          </p>
        </div>
        <div class="bisto-details">
          <p id="bisto-description">
            <span class="bisto-sentence">I developed BiSTO, a binary topology optimization framework designed for multiphysics applications.</span>
            <span class="bisto-sentence">
              It combines <span class="about-keep-word">AI-guided</span> design search with
              <span class="about-keep-word">physics-based</span> simulation.
            </span>
          </p>
          <ol class="bisto-workflow" aria-label="Optimization process">
            <li>AI search</li>
            <li>Simulation</li>
            <li>Design update</li>
          </ol>
        </div>
      </figure>
    </section>

    <section class="about-methods" aria-labelledby="about-methods-title">
      <h2 id="about-methods-title">Research Approach</h2>
      <ol class="about-method-list">
        {% for area in page.research_areas %}
          <li>
            <span class="about-method-number" aria-hidden="true">0{{ forloop.index }}</span>
            <h3>{{ area.title | escape }}</h3>
            <p>
              {{
                area.description
                | escape
                | replace: 'thermal-fluid', '<span class="about-keep-word">thermal-fluid</span>'
                | replace: 'Thermal-fluid', '<span class="about-keep-word">Thermal-fluid</span>'
                | replace: 'liquid-metal', '<span class="about-keep-word">liquid-metal</span>'
              }}
            </p>
          </li>
        {% endfor %}
      </ol>
    </section>

    {{ content }}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
<script defer src="{{ '/assets/js/about-bisto.js' | relative_url | bust_file_cache }}"></script>
