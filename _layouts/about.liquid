---
layout: default
---
{% assign cv = site.data.cv %}
{% assign cv_pdf_path = cv.source_pdf | prepend: '/assets/pdf/' | relative_url | bust_file_cache %}

<div class="post about-page">
  <article>
    <section class="about-intro" aria-labelledby="about-name">
      {% if page.profile.image %}
        <div class="about-portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_alt %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
          {% include figure.liquid path=profile_image_path class="about-portrait-image" sizes="(max-width: 767px) 128px, (max-width: 991px) 220px, 280px" alt=profile_alt loading="eager" cache_bust=true %}
        </div>
      {% endif %}

      <div class="about-intro-copy">
        <header class="about-identity">
          <h1 id="about-name">{{ site.first_name }} {{ site.last_name }}</h1>
          <p class="about-affiliation">{{ page.subtitle }}</p>
        </header>

        <div class="about-bio">
          {% for paragraph in page.bio_paragraphs %}
            <p>{{ paragraph | escape }}</p>
          {% endfor %}
        </div>

        <nav class="about-profile-links" aria-label="Academic profiles">
          <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="external noopener">Google Scholar</a>
          <a href="https://orcid.org/{{ site.data.socials.orcid_id }}" target="_blank" rel="external noopener">ORCID</a>
          <a href="https://www.scopus.com/authid/detail.uri?authorId={{ site.data.socials.scopus_id }}" target="_blank" rel="external noopener">Scopus</a>
          <a href="https://www.researchgate.net/profile/{{ site.data.socials.research_gate_profile }}/" target="_blank" rel="external noopener">ResearchGate</a>
          <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="external noopener">LinkedIn</a>
          <a class="about-cv-link" href="{{ cv_pdf_path }}" download="{{ cv.source_pdf }}">CV (PDF)</a>
        </nav>
      </div>
    </section>

    <section class="about-section about-bisto" aria-labelledby="bisto-title">
      <div class="about-section-head">
        <h2 id="bisto-title">Current Focus: BiSTO</h2>
      </div>

      <figure class="bisto-feature">
        <div class="bisto-visual">
          <div class="bisto-media">
            <video
              id="bisto-video"
              width="884"
              height="620"
              autoplay
              muted
              loop
              playsinline
              controls
              preload="auto"
              poster="{{ '/assets/img/bisto-poster.webp' | relative_url }}"
              aria-label="BiSTO topology evolution"
              aria-describedby="bisto-description bisto-regions bisto-sequence-note bisto-temperature-note"
            >
              <source src="{{ '/assets/video/bisto-topology.mp4' | relative_url }}" type="video/mp4">
              <img
                src="{{ '/assets/img/bisto-poster.webp' | relative_url }}"
                width="884"
                height="620"
                alt="Cutaway of a rotating beam dump showing shell temperature, black solid regions, and blue fluid regions."
              >
            </video>
            <script>
              (function () {
                var v = document.getElementById("bisto-video");
                if (v) v.controls = false;
              })();
            </script>
            <div class="bisto-annotations" aria-hidden="true">
              <div class="bisto-legend">
                <span class="bisto-legend-item"><span class="bisto-swatch bisto-swatch-solid"></span>Solid</span>
                <span class="bisto-legend-item"><span class="bisto-swatch bisto-swatch-fluid"></span>Fluid</span>
              </div>
              <span class="bisto-progress-track" aria-hidden="true" hidden>
                <span class="bisto-progress-fill"></span>
              </span>
            </div>
            <button
              class="bisto-toggle"
              type="button"
              aria-controls="bisto-video"
              aria-label="Play animation"
              title="Play animation"
              data-playing="false"
              hidden
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path class="bisto-icon-play" d="M 7,4 L 20,12 L 7,20 Z" />
                <g class="bisto-icon-pause"><rect x="5" y="4" width="5" height="16" /><rect x="14" y="4" width="5" height="16" /></g>
              </svg>
            </button>
          </div>
          <p class="sr-only" id="bisto-regions">
            Black cells in the cutaway represent solid structure and blue cells represent fluid cooling channels.
          </p>
          <p class="sr-only" id="bisto-sequence-note">The animation shows design iterations, not elapsed physical time.</p>
          <figcaption class="bisto-temperature-note" id="bisto-temperature-note">
            Solid regions and fluid cooling channels change over design iterations as the simulated outer shell temperature falls from red to blue
            green (FRIB rotating beam dump).
          </figcaption>
        </div>

        <div class="bisto-details">
          <p class="bisto-fullname">Binary Surrogate-based Topology Optimization</p>
          <div id="bisto-description">
            <p>
              Developed at FRIB for turbulent cooling channel design, <strong>BiSTO</strong> pairs a neural network surrogate with direct physics
              solver verification to optimize binary, connected layouts without requiring flow or turbulence adjoints.
            </p>
            <p>
              I also lead the overall fabrication and installation effort for the FRIB rotating beam dump, which is targeted for 2028 and planned to
              use a BiSTO cooling layout.
            </p>
          </div>
          <p class="bisto-status">
            Manuscript under review at <em>Applied Thermal Engineering</em>.
          </p>
        </div>
      </figure>
    </section>
  </article>
</div>
<script async src="{{ '/assets/js/about-bisto.js' | relative_url | bust_file_cache }}"></script>
