---
layout: default
---
<div class="project-detail{% if page.publication_notice %} project-preview{% endif %}">
  <a class="projects-back-link" href="{{ '/projects/' | relative_url }}"><span aria-hidden="true">&#8592;</span> All projects</a>
  <header class="project-detail-header">
    <p class="projects-kicker">
      {{ page.institution | escape }}
      <span aria-hidden="true">&middot;</span> {{ page.year | escape }}
    </p>
    <h1>{{ page.card_title | default: page.title | escape }}</h1>
    {% if page.fullname %}
      <p class="project-fullname">{{ page.fullname | escape }}</p>
    {% endif %}
    <p class="projects-intro">{{ page.summary | default: page.description | escape }}</p>
    {% unless page.publication_notice %}
      <dl class="project-brief">
        <div>
          <dt>My contribution</dt>
          <dd>{{ page.contribution | escape }}</dd>
        </div>
        <div>
          <dt>{{ page.evidence | default: 'Research outcome' | escape }}</dt>
          <dd>{{ page.outcome | escape }}</dd>
        </div>
      </dl>
    {% endunless %}
  </header>
  {% assign project_body = content | strip %}
  {% if project_body != '' %}
    <article class="project-body">
      {{ content }}
    </article>
  {% endif %}
  {% if page.publication_notice %}
    <p class="project-publication-notice">{{ page.publication_notice | escape }}</p>
  {% endif %}
  <nav class="project-detail-end" aria-label="Project navigation">
    <a class="projects-text-link" href="{{ '/projects/' | relative_url }}"><span aria-hidden="true">&#8592;</span> All projects</a>
    <a class="projects-text-link" href="{{ '/publications/' | relative_url }}">Publications <span aria-hidden="true">&#8594;</span></a>
  </nav>
</div>
<script defer src="{{ '/assets/js/project-gallery.js' | relative_url | bust_file_cache }}"></script>
