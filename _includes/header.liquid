<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title{% if page.permalink == '/' %} navbar-brand-home{% endif %}" href="{{ site.baseurl }}/">
        {{- site.title -}}
      </a>

      <div class="navbar-mobile-actions">
        {% if site.enable_darkmode %}
          <button
            id="light-toggle-mobile"
            class="theme-toggle-btn d-md-none"
            type="button"
            title="Switch to dark mode"
            aria-label="Switch to dark mode"
            data-theme-toggle
          >
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4.5"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2.5 12h2M19.5 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
          </button>
        {% endif %}

        <!-- Navbar Toggle -->
        <button
          class="navbar-toggler collapsed"
          type="button"
          data-toggle="collapse"
          data-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar top-bar"></span>
          <span class="icon-bar middle-bar"></span>
          <span class="icon-bar bottom-bar"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for p in site.pages %}
            {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title | default: 'About' }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              {% assign is_active = false %}
              {% if page.url contains parent_link %}
                {% assign is_active = true %}
              {% elsif parent_link == '/research/' and page.url contains '/projects/' %}
                {% assign is_active = true %}
              {% endif %}
              <li class="nav-item {% if is_active %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="nav-link" href="{{ url | relative_url }}">
                  {{- p.title }}
                  {% if is_active %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}

          {% if site.enable_darkmode %}
            <!-- Toggle theme mode (desktop) -->
            <li class="toggle-container d-none d-md-flex">
              <button
                id="light-toggle"
                class="theme-toggle-btn"
                type="button"
                title="Switch to dark mode"
                aria-label="Switch to dark mode"
                data-theme-toggle
              >
                <svg id="light-toggle-light" class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
                <svg id="light-toggle-dark" class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="4.5"></circle>
                  <path d="M12 2.5v2M12 19.5v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2.5 12h2M19.5 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
                </svg>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0" aria-hidden="true">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
