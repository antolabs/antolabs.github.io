{% assign project = include.project %}
<a
  class="research-card{% if project.thumb %} research-card-has-media{% endif %}"
  href="{{ project.url | relative_url }}"
  aria-labelledby="card-{{ project.slug }}"
>
  {% if project.thumb %}
    {% assign thumb_stem = project.thumb | remove: '.jpg' | remove: '.jpeg' | remove: '.png' | remove: '.tiff' | remove: '.gif' %}
    {% assign thumb_ext = project.thumb | split: '.' | last %}
    <div class="research-card-media">
      <picture>
        {% if site.imagemagick.enabled and (thumb_ext == 'png' or thumb_ext == 'jpg' or thumb_ext == 'jpeg' or thumb_ext == 'gif' or thumb_ext == 'tiff') %}
          <source
            srcset="{% for w in site.imagemagick.widths %}{{ thumb_stem | prepend: '/' | relative_url }}-{{ w }}.webp {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
            sizes="(max-width: 767px) 92vw, 440px"
            type="image/webp"
          >
        {% endif %}
        <img
          src="{{ project.thumb | prepend: '/' | relative_url }}"
          alt="{{ project.thumb_alt | default: project.card_title | default: project.title | escape }}"
          loading="lazy"
          decoding="async"
        >
      </picture>
    </div>
  {% endif %}
  <div class="research-card-body">
    <div class="research-card-meta">
      <span>{{ project.institution | escape }}</span>
      <span aria-hidden="true">&middot;</span>
      <span>{{ project.year | escape }}</span>
    </div>
    <h3 id="card-{{ project.slug }}">{{ project.card_title | default: project.title | escape }}</h3>
    <p class="research-card-summary">{{ project.summary | escape }}</p>
    {% assign card_detail = project.scope_note | default: project.outcome %}
    {% if card_detail %}
      <p class="research-card-support{% if project.outcome %} research-card-outcome{% endif %}">
        {{
          card_detail
          | escape
          | replace: '50 kW', '<span class="text-nowrap">50 kW</span>'
          | replace: '100 kW', '<span class="text-nowrap">100 kW</span>'
        }}
      </p>
    {% endif %}
    <div class="research-card-footer">
      <span class="research-card-action">
        View case study <span aria-hidden="true">&#8594;</span>
      </span>
    </div>
  </div>
</a>
